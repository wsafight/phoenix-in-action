<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>AuctionWeb · Phoenix Framework</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static src={~p"/assets/phoenix_html.js"}>
    </script>
    <script defer phx-track-static src={~p"/assets/phoenix.js"}>
    </script>
    <script defer phx-track-static src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    <header>
      <section class="container">
        <nav role="navigation">
          <ul>
            <li><a href="https://hexdocs.pm/phoenix/overview.html">Get Started</a></li>
          </ul>
        </nav>
        <a href="http://phoenixframework.org/" class="phx-logo">
          <img src={~p"/images/phoenix.png"} alt="Phoenix Framework Logo" />
        </a>
      </section>
    </header>
    <div
      class="container"
      style="border-bottom: 1px solid #777777; margin-bottom: 2rem; padding-bottom: 1rem;"
    >
      <.link navigate={~p"/items"}>Items</.link>
      |
      <%= if @current_user do %>
        Logged in as
        <.link navigate={~p"/users/#{@current_user.id}"}>{@current_user.username}</.link>
        | <.link href={~p"/logout"} method="delete">Log out</.link>
      <% else %>
        <.link navigate={~p"/login"}>login</.link>
      <% end %>
    </div>
    <main role="main" class="container">
      <.flash_group flash={@flash} />
      {@inner_content}
    </main>
  </body>
</html>
