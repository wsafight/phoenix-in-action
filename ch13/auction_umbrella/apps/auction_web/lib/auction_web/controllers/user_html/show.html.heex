<h1>User details</h1>

<dl>
  <dt>Username</dt>
  <dd>{@user.username}</dd>
  <br />
  <dt>Email address</dt>
  <dd>{@user.email_address}</dd>
</dl>

<h2>Recent bids</h2>

<p :for={bid <- @bids}>
  <strong>{formatted_datetime(bid.inserted_at)}</strong>
  -- {integer_to_currency(bid.amount)} for
  <em><.link href={~p"/items/#{bid.item.id}"}>{bid.item.title}</.link></em>
</p>
